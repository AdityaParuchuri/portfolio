{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aditya",
  "account_id": "d077181d22ab5d2ecf69c3d772717dbd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aditya"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "a2832c3c01c745f09c1c711a9936f16e"
    }
  ],
  "d1_databases": [
    {
      "binding": "VISITS_DB",
      "database_name": "portfolio-visits",
      "database_id": "855e1e02-0c7f-44ec-9193-4e41463ca0e5"
    }
  ]
}
